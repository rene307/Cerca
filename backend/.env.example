# CERCA.cl - PostgreSQL LOCAL (base de datos: cerca)
# Crear previamente una base NUEVA en pgAdmin llamada cerca.
# No renombrar ni sobrescribir DondeAhi, ccc_db ni otras bases.
PGHOST=localhost
PGPORT=5432
PGDATABASE=cerca
PGUSER=postgres
# Escribir la contrasena local de PostgreSQL SOLO en tu archivo .env
PGPASSWORD=

# Alternativa para PostgreSQL remoto: si la usas, dejar las PG* coherentes
# y poner /cerca al final de la URL. DATABASE_URL tiene prioridad.
# DATABASE_URL=postgresql://usuario:CLAVE@servidor:5432/cerca

# ADMIN_EMAIL: único correo autorizado a solicitar el acceso (NO recibe otros correos).
ADMIN_EMAIL=renerivaslabarca@gmail.com
# Configuración del proveedor SMTP. Usa una contraseña de aplicación o API de SMTP.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-usuario-smtp
SMTP_PASS=
SMTP_FROM="CERCA.cl <tu-correo@ejemplo.cl>"
# Obligatorio: secreto aleatorio de 32+ caracteres.
JWT_SECRET=
# Frontend autorizado
CORS_ORIGINS=http://localhost:4200
PORT=4200
# PGSSLMODE=require

# INICIO RECOMENDADO: INICIAR_CERCA_UN_SERVIDOR.bat sirve web, API y SEO en 4200.
# Los antiguos 01_API_CERCA.bat + 02_WEB_CERCA.bat se dejan solo para desarrollo.

# SEO: URL pública REAL del proyecto (sin barra final). Obligatoria antes de publicar.
# Ojo: cerca.cl actualmente muestra un sitio de escuela de conductores; confirma el dominio.
SITE_URL=http://localhost:4200
